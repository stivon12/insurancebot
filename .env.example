# Required
GEMINI_API_KEY=
SERPER_API_KEY=            # Google Shopping prices (https://serper.dev)
# Optional
SERPAPI_API_KEY=           # backup shopping search if Serper fails
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
CONTACT_EMAIL=             # sent in the Open Library User-Agent

CLAIM_COUNTRY=US
SECOND_COUNTRY=GB
APPRAISAL_THRESHOLD=250
LIVE_MODEL=gemini-3.8-live
VISION_MODEL=gemini-3.8-flash
LITE_MODEL=gemini-3.1-flash-lite
LIVE_VOICE=Kore
