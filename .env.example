# Required
GEMINI_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional (raises Google Books quota; works without for light use)
GOOGLE_BOOKS_API_KEY=
# Optional backup price source when eBay has no listing: Google Shopping via SerpApi
# (free plan, 250 searches/month; https://serpapi.com/users/sign_up). About 2 searches per book it is used for.
SERPAPI_API_KEY=
SERPAPI_HOURLY_LIMIT=45

# Locale (country code: US or GB)
CLAIM_COUNTRY=US
SECOND_COUNTRY=GB

# Models (override if a newer version is available)
LIVE_MODEL=gemini-3.8-live
VISION_MODEL=gemini-3.8-flash
LITE_MODEL=gemini-3.1-flash-lite
LIVE_VOICE=Kore

# Books above this value (local currency) go to human appraisal
APPRAISAL_THRESHOLD=250
# Contact used in the Open Library User-Agent header
CONTACT_EMAIL=
